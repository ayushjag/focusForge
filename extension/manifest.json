{
  "manifest_version": 3,
  "name": "FocusForge",
  "description": "Stay focused during active FocusForge sessions.",
  "version": "0.6.0",
  "permissions": ["storage", "alarms", "declarativeNetRequest"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_title": "FocusForge",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content/web-sync.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
