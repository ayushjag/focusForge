generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

model User {
  id             String         @id @default(cuid())
  authProviderId String         @unique
  email          String         @unique
  passwordHash   String?
  timezone       String         @default("UTC")
  tasks          Task[]
  focusSessions  FocusSession[]
  dailyGoalTargets DailyGoalTarget[]
  weeklyPlans    WeeklyPlan[]
  blockedWebsites BlockedWebsite[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model DailyGoalTarget {
  id            String   @id @default(cuid())
  userId        String
  effectiveDate String
  targetMinutes Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, effectiveDate])
}

model WeeklyPlan {
  id         String   @id @default(cuid())
  userId     String
  weekStart  String
  priorities String[] @default([])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, weekStart])
}

model BlockedWebsite {
  id        String   @id @default(cuid())
  userId    String
  domain    String
  enabled   Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, domain])
  @@index([userId, enabled])
}

model Task {
  id             String         @id @default(cuid())
  userId         String
  title          String
  description    String?
  priority       TaskPriority   @default(MEDIUM)
  status         TaskStatus     @default(PENDING)
  completedAt    DateTime?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusSessions  FocusSession[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, status])
  @@index([userId, completedAt])
  @@index([userId, scheduledStart])
}

model FocusSession {
  id                     String        @id @default(cuid())
  userId                 String
  taskId                 String
  plannedDurationMinutes Int
  plannedEnd             DateTime
  actualStart            DateTime      @default(now())
  actualEnd              DateTime?
  status                 SessionStatus @default(ACTIVE)
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                   Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, actualStart])
  @@index([userId, status, actualEnd])
  @@index([status, plannedEnd])
  @@index([taskId])
  // A PostgreSQL partial unique index in the migration permits one ACTIVE session per user.
}
